{
  "expo": {
    "name": "VerifyAI",
    "slug": "verifyai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#090D16",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.verifyai.app",
      "infoPlist": {
        "NSCameraUsageDescription": "VerifyAI uses your camera to capture photos for AI fact-checking and deepfake forensics.",
        "NSPhotoLibraryUsageDescription": "VerifyAI accesses your photo library to verify image veracity."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#090D16"
      },
      "package": "com.verifyai.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow VerifyAI to access your photos for image verification."
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "f6a58a5e-368d-4c7f-9498-60e2a5690a4d"
      }
    },
    "owner": "krishna8979",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/f6a58a5e-368d-4c7f-9498-60e2a5690a4d"
    }
  }
}
