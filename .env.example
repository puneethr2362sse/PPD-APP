# Firebase Authentication Configuration for VerifyAI (Client-side)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Server-Side Gemini API Key (Backend only - never expose with VITE_ prefix)
GEMINI_API_KEY=your_google_gemini_api_key_here
PORT=5000

# Optional: Frontend API URL (leave unset to use local /api proxy or Vercel serverless)
# VITE_API_BASE_URL=https://your-backend.onrender.com/api
# VITE_API_TARGET=http://localhost:5000
